# ============================================
# Configuración de Base de Datos
# ============================================
DB_DATABASE=agendamiento_citas
DB_USERNAME=root
DB_PASSWORD=root
DB_PORT=3306
# Nota: MySQL no permite crear un usuario llamado "root" con MYSQL_USER
# Por eso usamos MYSQL_ROOT_PASSWORD directamente. El backend se conecta como root.

# ============================================
# Configuración de Backend (Laravel)
# ============================================
BACKEND_PORT=8000
APP_ENV=local
APP_DEBUG=true
APP_KEY=

# ============================================
# Configuración de Frontend (React)
# ============================================
FRONTEND_PORT=3000
# REACT_APP_API_URL: Dejar vacío para usar proxy nginx (recomendado en Docker)
#                    O usar URL completa para producción externa
# Ejemplos:
#   - Vacío (Docker con proxy): REACT_APP_API_URL=
#   - Producción externa: REACT_APP_API_URL=https://api.tu-dominio.com/api
REACT_APP_API_URL=

# ============================================
# Notas:
# ============================================
# 1. Copia este archivo a .env: cp docker-compose.env.example .env
# 2. Ajusta los valores según tu entorno
# 3. Para producción, cambia APP_ENV=production y APP_DEBUG=false
# 4. REACT_APP_API_URL:
#    - Vacío: El frontend usa rutas relativas (/api) que nginx redirige al backend
#    - Con URL: El frontend se conecta directamente a esa URL (útil para producción externa)
# 5. El contenedor del backend se llama: gestion_citas_backend
#    El nombre del servicio en docker-compose es: backend

